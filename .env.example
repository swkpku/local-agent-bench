# Runtime
LLAMA_SERVER_BIN=llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_BASE_URL=http://127.0.0.1:8080/v1

# First stack: llama-server + Qwen3.5 9B Q4_K_M GGUF + simple prompting.
LLAMA_MODEL_ALIAS=qwen3.5-9b-q4_k_m
LLAMA_MODEL_SOURCE=url
LLAMA_HF_REPO=bartowski/Qwen_Qwen3.5-9B-GGUF:Q4_K_M
LLAMA_MODEL_URL=https://huggingface.co/bartowski/Qwen_Qwen3.5-9B-GGUF/resolve/main/Qwen_Qwen3.5-9B-Q4_K_M.gguf

# For a local GGUF instead of Hugging Face cache, set:
# LLAMA_MODEL_SOURCE=path
# LLAMA_MODEL_PATH=/absolute/path/to/Qwen_Qwen3.5-9B-Q4_K_M.gguf

# Conservative defaults for a 16 GB Apple Silicon Mac.
LLAMA_CTX_SIZE=8192
LLAMA_N_GPU_LAYERS=auto
LLAMA_THREADS=8
LLAMA_PARALLEL=1
LLAMA_CACHE_DIR=.cache/llama.cpp
LLAMA_NO_MMPROJ=1
LLAMA_REASONING=off

# Prompt defaults
LOCALAI_CONFIG=config/stack.json
LOCALAI_PROMPT=prompts/simple.md
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=512
THINKING=off
