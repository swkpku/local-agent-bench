# Runtime
LLAMA_SERVER_BIN=llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_BASE_URL=http://127.0.0.1:8080/v1

# First stack: llama-server + Qwen3.5 9B Q4_K_M GGUF + simple prompting.
LLAMA_MODEL_ALIAS=qwen3.5-9b-q4_k_m
LLAMA_MODEL_SOURCE=url
LLAMA_HF_REPO=bartowski/Qwen_Qwen3.5-9B-GGUF:Q4_K_M
LLAMA_MODEL_URL=https://huggingface.co/bartowski/Qwen_Qwen3.5-9B-GGUF/resolve/main/Qwen_Qwen3.5-9B-Q4_K_M.gguf

# Gemma 4 QAT (quantization-aware-trained, near-bf16 quality). Unsloth's Dynamic 2.0
# UD-Q4_K_XL is higher-accuracy AND smaller than Google's plain Q4_0.
# 12B is the best Gemma fit for a 16 GB Mac (~6.7 GB weights, 256K ctx, native tool calls):
# LLAMA_MODEL_ALIAS=gemma-4-12b-qat
# LLAMA_HF_REPO=unsloth/gemma-4-12B-it-qat-GGUF
# LLAMA_MODEL_URL=https://huggingface.co/unsloth/gemma-4-12B-it-qat-GGUF/resolve/main/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
# Gemma's documented sampling: LLAMA_TEMP=1.0 LLAMA_TOP_P=0.95 LLAMA_TOP_K=64 (lower temp for deterministic tool calls)
#
# Lighter alternative (~4.2 GB, effective 4.5B):
# LLAMA_MODEL_ALIAS=gemma-4-e4b-qat
# LLAMA_HF_REPO=unsloth/gemma-4-E4B-it-qat-GGUF
# LLAMA_MODEL_URL=https://huggingface.co/unsloth/gemma-4-E4B-it-qat-GGUF/resolve/main/gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf
#
# Google's official plain-Q4_0 GGUFs (fallback): google/gemma-4-12B-it-qat-q4_0-gguf,
# google/gemma-4-E4B-it-qat-q4_0-gguf

# For a local GGUF instead of Hugging Face cache, set:
# LLAMA_MODEL_SOURCE=path
# LLAMA_MODEL_PATH=/absolute/path/to/Qwen_Qwen3.5-9B-Q4_K_M.gguf

# Agentic profile defaults for a 16 GB Apple Silicon Mac.
LLAMA_CTX_SIZE=131072            # 128K window (~8 GB RAM). No prefix caching, so full use re-prefills every turn = slow. Drop to 16384-32768 for snappy turns
LLAMA_N_GPU_LAYERS=auto         # all layers on Metal
LLAMA_THREADS=4                 # M4 performance cores (test 8)
LLAMA_PARALLEL=1                # full context window to the one active agent
LLAMA_CACHE_DIR=.cache/llama.cpp
LLAMA_NO_MMPROJ=1               # text-only
LLAMA_REASONING=off             # 'auto' to let the model think before tool calls

# Throughput / memory (q8_0 KV requires LLAMA_FLASH_ATTN=on)
LLAMA_FLASH_ATTN=on
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_BATCH=2048
LLAMA_UBATCH=1024               # larger = faster prefill on big agent prompts

# Server-side sampling defaults (clients override per request)
LLAMA_TEMP=0.2
LLAMA_TOP_P=0.8
LLAMA_TOP_K=20
# LLAMA_SEED=42                 # set for reproducible benchmarking
# LLAMA_METRICS=1               # enable GET /metrics (Prometheus)

# Prompt defaults
LOCALAI_CONFIG=config/stack.json
LOCALAI_PROMPT=prompts/simple.md
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=512
THINKING=off

# Agents (need a running llama-server)
# pi: provider + model id registered in ~/.pi/agent/models.json
PI_PROVIDER=localai
PI_MODEL=qwen3.5-9b-q4_k_m
# Qwen-Agent: OpenAI-compatible target for the local server
QWEN_BASE_URL=http://127.0.0.1:8080/v1
QWEN_MODEL=qwen3.5-9b-q4_k_m
QWEN_API_KEY=EMPTY
QWEN_VENV=.venv
